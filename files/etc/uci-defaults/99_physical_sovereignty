#!/bin/sh
# --- MT7986 物理主權 v9.0 (四核矩陣·算力全解版) ---

logger -t "Sovereignty" "啟動 v9.0：四核矩陣重構 (MT7986 專用)"

# 1. 喚醒硬件模組 (硬件引擎是四合一的基石)
modprobe crypto_safexcel 2>/dev/null
echo 1 > /proc/sys/net/netfilter/nf_flow_table_hw 2>/dev/null

# 2. 四核矩陣：IRQ 深度隔離 (不再是交錯，而是專核專用)
# ---------------------------------------------------------
ETH_IRQ=$(grep -m1 "mtk-network" /proc/interrupts | cut -d: -f1 | tr -d ' ')
WIFI_IRQ=$(grep -m1 "mt7986" /proc/interrupts | cut -d: -f1 | tr -d ' ')
CRYPTO_IRQ=$(grep "eip" /proc/interrupts | cut -d: -f1)

# CPU0: 系統與基礎任務守護
# CPU1: 有線網絡 (Ethernet) 專屬核心
[ -n "$ETH_IRQ" ] && echo 2 > "/proc/irq/$ETH_IRQ/smp_affinity" # 0010

# CPU2: 加密引擎 (Crypto) 專屬核心 - 讓隧道流量獨佔一核，牆外 4K 秒開的關鍵
for irq in $CRYPTO_IRQ; do echo 4 > "/proc/irq/$irq/smp_affinity"; done # 0100

# CPU3: 無線網絡 (WiFi) 專屬核心 - 確保高負載下無線延遲穩如磐石
[ -n "$WIFI_IRQ" ] && echo 8 > "/proc/irq/$WIFI_IRQ/smp_affinity" # 1000

# 3. RPS 四核聯動：全量開啟 (掩碼 F = 1111)
# ---------------------------------------------------------
# 四核模式下，RPS 是不同核心間數據包“接力”的橋樑
for rps_file in /sys/class/net/*/queues/rx-*/rps_cpus; do echo f > "$rps_file"; done
# 提高流表深度，對應 MT7986 的大內存與四核併發
for rps_flow in /sys/class/net/*/queues/rx-*/rps_flow_cnt; do echo 4096 > "$rps_flow"; done
echo 16384 > /proc/sys/net/core/rps_sock_flow_entries

# 4. 系統級內核調優 (針對四核 A53 2.0GHz 高頻優化)
# ---------------------------------------------------------
cat >> /etc/sysctl.conf <<EOF
# 四核心跳優化：適度拉長調度週期，減少核間切換開銷
kernel.sched_latency_ns=10000000
kernel.sched_min_granularity_ns=2000000
kernel.sched_wakeup_granularity_ns=2500000

# 提高軟中斷預算：四核同時開工，預算要給足
net.core.netdev_budget=2000
net.core.netdev_budget_usecs=20000

# 內存與緩衝區 (MT7986 通常配備 512M/1G 內存，參數直接翻倍)
vm.min_free_kbytes=40960
net.core.rmem_max=33554432
net.core.wmem_max=33554432
net.ipv4.tcp_rmem=4096 131072 33554432
net.ipv4.tcp_wmem=4096 131072 33554432

# BBR + FQ_CODEL (黃金組合)
net.core.default_qdisc=fq_codel
net.ipv4.tcp_congestion_control=bbr
EOF
sysctl -p

# 5. zRAM 狂暴模式 (zstd)
# MT7986 算力足，zstd 級別可以設高一點，內存壓縮更極致
if [ -b /dev/zram0 ]; then
    swapoff /dev/zram0 2>/dev/null
    echo 1 > /sys/block/zram0/reset 2>/dev/null
    echo zstd > /sys/block/zram0/comp_algorithm
    TOTAL_MEM=$(free | grep Mem | awk '{print $2}')
    echo $((TOTAL_MEM * 1024)) > /sys/block/zram0/disksize
    mkswap /dev/zram0 >/dev/null
    swapon -p 20 /dev/zram0
fi

# 6. 強制定頻性能模式
for i in /sys/devices/system/cpu/cpufreq/policy*; do echo performance > "$i/scaling_governor"; done

logger -t "Sovereignty" "v9.0 部署完畢：四核矩陣已合閘，算力全線對齊。"
exit 0
